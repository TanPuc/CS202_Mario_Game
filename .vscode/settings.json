{
    "files.associations": {
        "*.cpp": "cpp",
        "iostream": "cpp",
        "charconv": "cpp",
        "format": "cpp",
        "sstream": "cpp",
        "xhash": "cpp",
        "xlocnum": "cpp",
        "xmemory": "cpp",
        "*.m": "cpp",
        "vector": "cpp",
